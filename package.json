{
  "name": "@local/dsh-market",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Skill market and MCP connector market for DeepSeek Harness: browse, install, and use plain SKILL.md skills and plain MCP servers without restarting DSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "catalog",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
